# ── Stage 1: build libtree-sitter0.25 + libtree-sitter-dev (C library only) ──
FROM debian:trixie AS tree-sitter-builder
WORKDIR /build
ENV DEBIAN_FRONTEND=noninteractive

ARG TREE_SITTER_VERSION=0.25.9

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ;

# Download orig tarball and build only the C library
RUN set -eux; \
    curl -fsSL "http://deb.debian.org/debian/pool/main/t/tree-sitter/tree-sitter_${TREE_SITTER_VERSION}.orig.tar.xz" \
        | tar -xJ; \
    make -C tree-sitter-${TREE_SITTER_VERSION} PREFIX=/usr -j$(nproc); \
    make -C tree-sitter-${TREE_SITTER_VERSION} install PREFIX=/usr DESTDIR=/staging

# Package into minimal .deb files
RUN set -eux; \
    mkdir /output; \
    \
    SOEXTVER=$(printf '%s' "${TREE_SITTER_VERSION}" | cut -d. -f1,2); \
    mkdir -p /pkg-rt/usr/lib /pkg-rt/DEBIAN; \
    cp -d /staging/usr/lib/libtree-sitter.so.${SOEXTVER} \
          /staging/usr/lib/libtree-sitter.so.0 \
          /pkg-rt/usr/lib/; \
    printf "Package: libtree-sitter0.25\nVersion: %s-1\nArchitecture: amd64\nMaintainer: local\nDepends: libc6\nSection: libs\nPriority: optional\nDescription: Tree-sitter C parsing library\n" \
        "${TREE_SITTER_VERSION}" > /pkg-rt/DEBIAN/control; \
    dpkg-deb --build /pkg-rt /output/libtree-sitter0.25_${TREE_SITTER_VERSION}-1_amd64.deb; \
    \
    mkdir -p /pkg-dev/usr/lib/pkgconfig /pkg-dev/usr/include/tree_sitter /pkg-dev/DEBIAN; \
    cp    /staging/usr/lib/libtree-sitter.a              /pkg-dev/usr/lib/; \
    cp -d /staging/usr/lib/libtree-sitter.so             /pkg-dev/usr/lib/; \
    cp    /staging/usr/include/tree_sitter/api.h         /pkg-dev/usr/include/tree_sitter/; \
    cp    /staging/usr/lib/pkgconfig/tree-sitter.pc      /pkg-dev/usr/lib/pkgconfig/; \
    printf "Package: libtree-sitter-dev\nVersion: %s-1\nArchitecture: amd64\nMaintainer: local\nDepends: libtree-sitter0.25 (= %s-1)\nSection: libdevel\nPriority: optional\nDescription: Tree-sitter C parsing library (development files)\n" \
        "${TREE_SITTER_VERSION}" "${TREE_SITTER_VERSION}" > /pkg-dev/DEBIAN/control; \
    dpkg-deb --build /pkg-dev /output/libtree-sitter-dev_${TREE_SITTER_VERSION}-1_amd64.deb

# ── Stage 2: build Emacs ─────────────────────────────────────────────────────
FROM debian:trixie
WORKDIR /opt
# Disable debconf UI.
ENV DEBIAN_FRONTEND=noninteractive

# Setup build system
RUN echo 'deb-src http://deb.debian.org/debian/ trixie main' >> /etc/apt/sources.list
RUN echo 'deb-src http://deb.debian.org/debian/ trixie-updates main' >> /etc/apt/sources.list
RUN echo 'deb-src http://security.debian.org/debian-security trixie-security main' >> /etc/apt/sources.list
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update ; \
    apt-get install --yes --no-install-recommends \
    apt-transport-https\
    autoconf \
    build-essential \
    ca-certificates \
    git \
    pkg-config \
    ; \
    update-ca-certificates ;

# Install build deps
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update ; \
    apt-get install --yes --no-install-recommends  \
    libacl1-dev \
    libasound2-dev \
    libdbus-1-dev \
    libgccjit-14-dev \
    libgif-dev \
    libgnutls28-dev \
    libgpm-dev \
    libgtk-3-dev \
    libjansson-dev \
    libjbig-dev \
    libjpeg-dev \
    libjpeg62-turbo-dev \
    liblcms2-dev\
    liblockfile-dev \
    libm17n-dev \
    libncurses-dev\
    libotf-dev \
    libpng-dev \
    librsvg2-dev  \
    libsystemd-dev \
    libtiff-dev \
    libxml2-dev \
    libxpm-dev \
    texinfo \
    ;

# Install libtree-sitter 0.25 built from sid source
COPY --from=tree-sitter-builder /output/*.deb /tmp/ts-debs/
# Also copy the tres-sitter to /opt/packages/
COPY --from=tree-sitter-builder /output/*.deb /opt/packages/
RUN dpkg -i /tmp/ts-debs/*.deb && rm -rf /tmp/ts-debs

ENV CC="gcc-14"

# Get sources
COPY emacs emacs

# CONFIGURE

RUN set -eux; \
    cd emacs; \
    ./autogen.sh ; \
    ./configure \
    --prefix "/usr" \
    --with-dbus \
    --with-gif \
    --with-gnutls \
    --with-jpeg \
    --with-libsystemd \
    --with-mailutils \
    --with-modules \
    --with-native-compilation \
    --with-pgtk \
    --with-png \
    --with-rsvg \
    --with-tiff \
    --with-tree-sitter \
    --with-xft \
    --with-xinput2 \
    --with-xpm \
    --without-xaw3d \
    --without-cairo \
    CFLAGS="-O2 -pipe -fomit-frame-pointer"

# BUILD
RUN make -C emacs NATIVE_FULL_AOT=1 -j $(nproc)

ARG EMACS_VERSION
ARG PKG_VERSION

# PACKAGE
RUN set -eux ; \
    PKG_NAME=/opt/emacs-pgtk_$PKG_VERSION \
    BINARIES=${PKG_NAME}/usr/bin \
    SHLIBS=${PKG_NAME}/usr/lib/emacs/${EMACS_VERSION}/native-lisp ; \
    cd emacs ; \
    make install prefix=${PKG_NAME}/usr ; \
    for i in ${BINARIES}/*; do strip --strip-unneeded --remove-section=.comment --remove-section=.note ${i}; done ; \
    for i in ${SHLIBS}/*/*.eln; do strip --strip-unneeded --remove-section=.comment --remove-section=.note ${i}; done ; \
    strip --strip-unneeded --remove-section=.comment --remove-section=.note ${PKG_NAME}/usr/libexec/emacs/${EMACS_VERSION}/x86_64-pc-linux-gnu/hexl ; \
    mkdir ${PKG_NAME}/DEBIAN ; \
    rm ${PKG_NAME}/usr/share/glib-2.0/schemas/gschemas.compiled ; \
    rm ${PKG_NAME}/usr/share/info/dir ; \
    rm -f ${PKG_NAME}/usr/share/info/*.txt ; \
    echo "Format: http://www.debian.org/doc/packaging-manuals/copyright-format/1.0/\n\
Upstream-Name: Emacs\n\
Source: https://www.gnu.org/software/emacs/\n\n\
Files: *\n\
Copyright: Copyright Free Software Foundation, Inc.\n\
License: GPL-3" \
    > ${PKG_NAME}/DEBIAN/copyright ; \
    echo "Package: emacs-pgtk\n\
Source: emacs\n\
Version: ${PKG_VERSION}-1\n\
Architecture: amd64\n\
Maintainer: ndrvtl <7734025+ndrvtl@users.noreply.github.com>\n\
Depends: libacl1, libc6, libdbus-1-3, libgccjit0, libgif7, libgtk-3-0, libjansson4, libjpeg62-turbo, libm17n-0, libotf1, librsvg2-2, libtiff6, libtree-sitter0.25, libwebpdecoder3\n\
Conflicts: emacs-common\n\
Section: editors\n\
Priority: optional\n\
Homepage: https://www.gnu.org/software/emacs/\n\
Description: Emacs with pure GTK support.\n\
 Compilation options:\n\
 --with-native-compilation \n\
 --with-pgtk \n\
 --with-json \n\
 --with-gnutls \n\
 --with-dbus \n\
 --with-gif \n\
 --with-jpeg \n\
 --with-png \n\
 --with-rsvg \n\
 --with-tiff \n\
 --with-xft \n\
 --with-xpm \n\
 --with-modules \n\
 --with-mailutils \n\
 --without-xaw3d \n\
 CFLAGS=\"-O2 -pipe -fomit-frame-pointer\"" > ${PKG_NAME}/DEBIAN/control ; \
    dpkg-deb --build ${PKG_NAME} ; \
    mkdir /opt/packages ; \
    mv ${PKG_NAME}.deb /opt/packages/emacs-pgtk_${PKG_VERSION}-1.deb

# Smoketest package
RUN set -eux; \
    apt-get install /opt/packages/emacs-pgtk_${PKG_VERSION}-1.deb ; \
    emacs --version
